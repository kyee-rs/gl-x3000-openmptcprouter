diff --git a/omr-tracker/files/usr/share/omr/post-tracking.d/002-error b/omr-tracker/files/usr/share/omr/post-tracking.d/002-error
index e801176a..581f1785 100755
--- a/omr-tracker/files/usr/share/omr/post-tracking.d/002-error
+++ b/omr-tracker/files/usr/share/omr/post-tracking.d/002-error
@@ -12,6 +12,52 @@ interface_up=$(ifstatus "$OMR_TRACKER_INTERFACE" 2>/dev/null | jsonfilter -q -e
 
 . "${OMR_LIB_DIR:-/usr/share/omr/lib}/common-post-tracking.sh"
 
+# Explicit MQVPN paths are transport-owned. A tracker miss must not remove an
+# MPTCP endpoint, fire disconnect hotplug, or point the VPS route at an
+# administratively-up path that cannot pass traffic.
+transport_managed="$(uci -q get omr-tracker.$OMR_TRACKER_INTERFACE.transport_managed)"
+transport_paths="$(uci -q get mqvpn.multipath.path)"
+if [ "$transport_managed" != "1" ] && \
+	[ "$(uci -q get mqvpn.settings.enable)" = "1" ] && \
+	[ "$(uci -q get mqvpn.multipath.auto_wan)" = "0" ]; then
+	for transport_path in $transport_paths; do
+		[ "$transport_path" = "$OMR_TRACKER_DEVICE" ] && transport_managed="1"
+	done
+fi
+
+if [ "$OMR_TRACKER_STATUS" = "ERROR" ] && [ "$transport_managed" = "1" ]; then
+	transport_server="$(uci -q get mqvpn.server.ip)"
+	[ -z "$transport_server" ] && transport_server="$(uci -q get openmptcprouter.vps.ip)"
+	transport_backup_device="$(uci -q get omr-tracker.$OMR_TRACKER_INTERFACE.transport_backup_device)"
+	if [ -z "$transport_backup_device" ]; then
+		for transport_path in $transport_paths; do
+			if [ "$transport_path" != "$OMR_TRACKER_DEVICE" ]; then
+				transport_backup_device="$transport_path"
+				break
+			fi
+		done
+	fi
+	transport_backup_gateway="$(ip -4 route show default dev "$transport_backup_device" 2>/dev/null | awk '/^default via / {print $3; exit}')"
+	transport_marker="/var/run/omr-tracker/transport-failover.$OMR_TRACKER_INTERFACE"
+
+	if [ -n "$transport_server" ] && [ -n "$transport_backup_device" ] && \
+		[ -n "$transport_backup_gateway" ] && \
+		ping -I "$transport_backup_device" -c 2 -W 1 "$transport_server" >/dev/null 2>&1; then
+		mkdir -p /var/run/omr-tracker >/dev/null 2>&1
+		if ip -4 route replace "$transport_server/32" via "$transport_backup_gateway" \
+			dev "$transport_backup_device" metric 1 >/dev/null 2>&1; then
+			if [ ! -f "$transport_marker" ]; then
+				printf '%s\n' "$transport_server $transport_backup_device $transport_backup_gateway" >"$transport_marker"
+				_log "$OMR_TRACKER_INTERFACE tracker error: keep MPTCP/MQVPN paths and move VPS route to $transport_backup_device"
+			fi
+		fi
+	fi
+
+	# Never tear down the current transport or redirect through an unproven
+	# backup. MQVPN continues health checks on both explicit sockets.
+	exit 0
+fi
+
 if [ "$OMR_TRACKER_STATUS" = "ERROR" ] && [ "$(uci -q get openmptcprouter.$OMR_TRACKER_INTERFACE.state)" != "down" ]; then
 	uci -q set openmptcprouter.$OMR_TRACKER_INTERFACE.state='down'
 	uci -q commit openmptcprouter
