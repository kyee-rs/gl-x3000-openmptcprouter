+/* A genuine kernel link/address event starts a new bounded recovery episode.
+ * Periodic polling never calls this helper, so an unchanged failed path is
+ * quarantined after PATH_RECOVER_FAILURE_LIMIT attempts instead of consuming
+ * path IDs forever. */
+static void
+reset_recovery_budget_by_ifname(platform_ctx_t *p, const char *ifname)
+{
+    for (int i = 0; i < p->path_mgr.n_paths; i++) {
+        if (strcmp(p->path_mgr.paths[i].iface, ifname) == 0)
+            p->path_recover_failures[i] = 0;
+    }
+}
