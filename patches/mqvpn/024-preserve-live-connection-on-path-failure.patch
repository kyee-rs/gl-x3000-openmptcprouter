+{
+    return !has_validated_sibling;
+}
+
+int
+mqvpn_path_recovery_record_failure(int failures, int limit)
+{
+    if (limit <= 0) return 0;
+    if (failures < 0) failures = 0;
+    return failures < limit ? failures + 1 : limit;
+}
+
+bool
+mqvpn_path_recovery_can_retry(int failures, int limit)
+{
+    return limit > 0 && failures < limit;
+}
