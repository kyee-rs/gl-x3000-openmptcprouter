+TEST(validated_sibling_forbids_connection_reconnect)
+{
+    ASSERT_FALSE(mqvpn_path_budget_should_reconnect(true));
+    ASSERT_TRUE(mqvpn_path_budget_should_reconnect(false));
+}
+
+TEST(path_recovery_failures_saturate_without_connection_escalation)
+{
+    int failures = 0;
+    for (int i = 0; i < 20; i++)
+        failures = mqvpn_path_recovery_record_failure(failures, 5);
+    ASSERT_TRUE(failures == 5);
+    ASSERT_FALSE(mqvpn_path_recovery_can_retry(failures, 5));
+    ASSERT_TRUE(mqvpn_path_recovery_can_retry(4, 5));
+}
