+static int
+client_find_validated_sibling(const mqvpn_client_t *c, int failed_idx)
+{
+    for (int i = 0; i < c->n_paths; i++) {
+        const path_entry_t *candidate = &c->paths[i];
+        if (i == failed_idx || !candidate->platform_attached || !candidate->xquic_path_live)
+            continue;
+        if (candidate->state == PATH_LC_ACTIVE || candidate->state == PATH_LC_STANDBY)
+            return i;
+    }
+    return -1;
+}
+
+static void
+client_force_reconnect_after_reactivate_loop(mqvpn_client_t *c, path_entry_t *p, int idx)
+{
+    if (!c || !p || !c->engine || !c->conn) return;
+    if (c->shutting_down || c->state == MQVPN_STATE_RECONNECTING ||
+        c->state == MQVPN_STATE_CLOSED || !c->config.reconnect_enable)
+        return;
+
+    int sibling_idx = client_find_validated_sibling(c, idx);
+    if (!mqvpn_path_reactivate_should_reconnect(
+            p->manual_reactivate_failures, p->recovery_reconnect_attempted,
+            sibling_idx >= 0))
+        return;
+
+    p->recovery_reconnect_attempted = 1;
+    c->primary_path_idx = sibling_idx;
+    c->preserve_primary_on_next_reconnect = 1;
+    LOG_W(c,
+          "path[%d] reactivation failed %u times on %s; reconnecting once "
+          "through validated sibling path[%d] %s",
+          idx, p->manual_reactivate_failures, p->name, sibling_idx,
+          c->paths[sibling_idx].name);
+
+    xqc_conn_close(c->engine, &c->conn->cid);
+    xqc_engine_main_logic(c->engine);
+}
+
